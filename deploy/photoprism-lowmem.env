# Copy these into the PhotoPrism container/LXC environment (not this dashboard's .env).
# PhotoPrism's own docs want 4 GB RAM + 4 GB swap. 3 GB + 512 MB swap will hang
# as soon as FFmpeg transcodes an iPhone video or builds a large thumbnail.

PHOTOPRISM_WORKERS=1
PHOTOPRISM_DISABLE_TENSORFLOW=true
PHOTOPRISM_DISABLE_FACES=true
PHOTOPRISM_DISABLE_CLASSIFICATION=true

# Do not render missing giant thumbs while someone is browsing. Pre-build 1280px
# during index instead.
PHOTOPRISM_THUMB_SIZE=1280
PHOTOPRISM_THUMB_SIZE_UNCACHED=1280
PHOTOPRISM_THUMB_UNCACHED=false

# Video play in the browser transcodes HEVC/MOV to H.264. That is what pegs CPU
# and RAM. Cap the encode, or set DISABLE_FFMPEG=true until you add RAM.
PHOTOPRISM_FFMPEG_SIZE=1280
PHOTOPRISM_FFMPEG_PRESET=veryfast
PHOTOPRISM_FFMPEG_QUALITY=40
# PHOTOPRISM_DISABLE_FFMPEG=true
