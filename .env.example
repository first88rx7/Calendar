GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of this dashboard, used for the OAuth redirect if GOOGLE_REDIRECT_URI is empty.
APP_URL=http://192.168.1.10:3847
GOOGLE_REDIRECT_URI=http://192.168.1.10:3847/api/auth/google/callback

MEALIE_URL=http://192.168.1.10:9925
MEALIE_TOKEN=
MEALIE_GROUP_SLUG=home

# First-boot weather only. A ZIP saved in Settings writes data/config.json and
# that file wins — otherwise systemd EnvironmentFile keeps these values forever.
WEATHER_LAT=47.6062
WEATHER_LON=-122.3321
WEATHER_TIMEZONE=America/Los_Angeles
WEATHER_UNIT=fahrenheit
WEATHER_LABEL=Seattle

FAMILY_NAME=Schumann Family
HOME_NAME=Riverside Home
WEEK_STARTS_ON=0
IDLE_TIMEOUT_MS=180000
SLEEP_DIM_PERCENT=78
SETTINGS_PIN=
SYNC_INTERVAL_MS=300000
DATA_DIR=./data

# PhotoPrism (optional). Leave blank to keep the scenic wallpaper.
PHOTOPRISM_URL=
PHOTOPRISM_USER=
PHOTOPRISM_PASSWORD=
# Or a client/app token used as a Bearer credential:
PHOTOPRISM_TOKEN=
PHOTOPRISM_ALBUM=
PHOTOPRISM_QUERY=
PHOTO_ROTATE_SEC=45
